{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 while any .py file is active
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      // F5 on this entry to run json2markdown.py input.json output_dir/
      "name": "Python: json2markdown",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/utils/json2markdown.py",
      "args": [
        "--input", "${workspaceFolder}/utils/database_sozluk/v12/gts_processed.json", // <input-json-file>
        "--output", "${workspaceFolder}/_terms" // <output-json-file>
      ],
      "console": "integratedTerminal"
    },
    {
      // F5 on this entry to run morph_analyzer.py input.json output.json
      "name": "Python: morph_analyzer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/utils/morph_analyzer.py",
      "args": [
        "--input", "${workspaceFolder}/utils/database_sozluk/v12/gts.json",   // <json-file>
        "--output", "${workspaceFolder}/utils/database_sozluk/v12/lemmas.json"         // <json-file>
      ],
      "console": "integratedTerminal"
    },
    {
      // F5 on this entry to run tdk_sozluk_processor.py
      "name": "Python: tdk_sozluk_processor",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/utils/tdk_sozluk_processor.py",
      "args": [
        "--input", "${workspaceFolder}/utils/database_sozluk/v12/gts.json",
        "--output", "${workspaceFolder}/utils/database_sozluk/v12/gts_processed.json"
      ],
      "console": "integratedTerminal"
    }
  ]
}