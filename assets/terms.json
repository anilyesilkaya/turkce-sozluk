---
layout: null
permalink: /assets/terms.json
---
[
{%- assign list = site.terms | sort: "title" -%}
{%- for term in list -%}
  {%- comment -%}
    Build a Turkish-insensitive "search" string:
    lower-case + remove diacritics + strip common punctuation
  {%- endcomment -%}
  {%- capture search_norm -%}
    {{- term.title
      | downcase
      | replace: "İ", "i" | replace: "ı", "i"
      | replace: "ş", "s" | replace: "Ş", "s"
      | replace: "ç", "c" | replace: "Ç", "c"
      | replace: "ğ", "g" | replace: "Ğ", "g"
      | replace: "ö", "o" | replace: "Ö", "o"
      | replace: "ü", "u" | replace: "Ü", "u"
      | replace: "â", "a" | replace: "î", "i" | replace: "û", "u"
      | replace: "’", ""  | replace: "'", ""
      | replace: ".", " " | replace: ",", " "
      | replace: "?", " " | replace: "!", " "
      | replace: "—", " " | replace: "…", " "
      | strip
    -}}
  {%- endcapture -%}
  {
    "title": {{ term.title | jsonify }},
    "url":   {{ term.url | relative_url | jsonify }},
    "search": {{ search_norm | strip_newlines | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
